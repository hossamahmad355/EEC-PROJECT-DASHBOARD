# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: Connection string for MongoDB (MongoDB Atlas or local MongoDB instance).
# Example: mongodb+srv://username:password@cluster.mongodb.net/construction_db?retryWrites=true&w=majority
# If omitted or offline, the app seamlessly runs on the high-performance local persistent store.
MONGODB_URI="mongodb://localhost:27017/construction_db"
